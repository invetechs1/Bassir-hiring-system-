APP_NAME="Bassir AI Recruitment System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FORCE_HTTPS=true
# Use TRUSTED_PROXIES=* behind Cloudflare/reverse proxies when your host requires it.
TRUSTED_PROXIES=
TRUSTED_HOSTS=your-domain.com
# Set true only when the host/proxy terminates SSL but PHP sees requests as HTTP.
APP_TRUST_PROXY_HTTPS_HEADERS=false

LOG_CHANNEL=stack
LOG_STACK_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=account_bassir
DB_USERNAME=account_bassir_user
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# sync = heavy AI ranking / auto-sourcing run inline (fine for low volume / shared hosting).
# Set to "database" for background processing at higher volume, then run a worker
# (php artisan queue:work) or a scheduled `queue:work --stop-when-empty` cron.
QUEUE_CONNECTION=sync
# Queue jobs table is named queue_jobs to avoid clashing with the recruitment jobs table.
DB_QUEUE_TABLE=queue_jobs
CACHE_STORE=file
FILESYSTEM_DISK=local

OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25
AI_RETRY_ATTEMPTS=1
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=
AGENCY_FEED_URL=
AGENCY_FEED_TOKEN=
OCR_SPACE_API_KEY=
CV_MALWARE_SCAN_COMMAND=
BASSIR_STORAGE_QUOTA_MB=1024
MOBILE_TOKEN_TTL_DAYS=30
MOBILE_API_MAX_PAGE_SIZE=100

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Automated web sourcing — official partner API connectors (optional).
# Leave blank until you hold the partner agreement + token; connectors stay dormant.
LINKEDIN_TALENT_API_TOKEN=
LINKEDIN_TALENT_API_ENDPOINT=
INDEED_PARTNER_API_KEY=
INDEED_PARTNER_API_ENDPOINT=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hr@your-domain.com
MAIL_FROM_NAME="Bassir Recruitment"
